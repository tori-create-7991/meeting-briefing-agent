resource "google_vertex_ai_reasoning_engine" "agent" {
  display_name = "meeting-briefing-agent"
  region       = var.region

  spec {
    agent_framework = "google-adk"
    # Generated by scripts/build_agent_source.sh (scripts/gen_class_methods.py);
    # required when deploying from source.
    class_methods = jsonencode(jsondecode(file(var.class_methods_file)))
    identity_type = var.runtime_identity == "agent_identity" ? "AGENT_IDENTITY" : "SERVICE_ACCOUNT"
    # Must stay unset with AGENT_IDENTITY.
    service_account = var.runtime_identity == "service_account" ? google_service_account.briefing_runtime[0].email : null

    source_code_spec {
      inline_source {
        source_archive = filebase64(var.agent_source_archive)
      }
      python_spec {
        entrypoint_module = "meeting_briefing_agent.agent_app"
        entrypoint_object = "app"
        requirements_file = "requirements.txt"
        version           = "3.12"
      }
    }

    deployment_spec {
      # Scale to zero between calls; this agent is only called on demand.
      min_instances = var.agent_min_instances
      max_instances = var.agent_max_instances

      # GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION and GOOGLE_CLOUD_AGENT_ENGINE*
      # are reserved and set by the runtime.
      env {
        name  = "GOOGLE_GENAI_USE_VERTEXAI"
        value = "TRUE"
      }
      env {
        name  = "WORKSPACE_AUTH"
        value = "dwd"
      }
      env {
        name  = "WORKSPACE_SA_EMAIL"
        value = google_service_account.workspace_reader.email
      }
      env {
        name  = "WORKSPACE_SUBJECT"
        value = var.workspace_subject
      }
      env {
        name  = "BRIEFING_MODEL"
        value = var.briefing_model
      }
      env {
        name  = "BRIEFING_LANGUAGE"
        value = var.briefing_language
      }
      env {
        name  = "BRIEFING_TIMEZONE"
        value = var.briefing_timezone
      }
    }
  }

  depends_on = [google_project_service.main]
}

locals {
  engine_id = reverse(split("/", google_vertex_ai_reasoning_engine.agent.id))[0]
  agent_principal = join("", [
    "principal://agents.global.org-${var.org_id}.system.id.goog",
    "/resources/aiplatform/projects/${data.google_project.this.number}",
    "/locations/${var.region}/reasoningEngines/${local.engine_id}",
  ])
  runtime_member = (
    var.runtime_identity == "agent_identity"
    ? local.agent_principal
    : "serviceAccount:${google_service_account.briefing_runtime[0].email}"
  )
}
